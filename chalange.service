[Unit]
Description=Chalange 1v1 Quiz (Flask-SocketIO)
After=network.target

[Service]
Type=simple
User=chalange
Group=chalange
WorkingDirectory=/opt/chalange
Environment="SECRET_KEY=ganti-kunci-rahasia-kamu-di-sini"
Environment="PORT=5000"
ExecStart=/opt/chalange/venv/bin/gunicorn -c gunicorn.conf.py app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
